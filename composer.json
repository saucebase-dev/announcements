{
  "name": "saucebase/announcements",
  "description": "Site-wide announcement banners for Saucebase, scheduled and targeted.",
  "type": "saucebase-module",
  "license": "MIT",
  "version": "v3.3.0",
  "require": {
    "saucebase/core": "^1.13"
  },
  "authors": [
    {
      "name": "Saucebase",
      "email": "hello@saucebase.dev"
    }
  ],
  "extra": {
    "saucebase": {
      "frameworks": [
        "vue",
        "react"
      ]
    },
    "laravel": {
      "providers": [
        "Modules\\Announcements\\Providers\\AnnouncementsServiceProvider"
      ],
      "aliases": {}
    }
  },
  "autoload": {
    "psr-4": {
      "Modules\\Announcements\\": "src/",
      "Modules\\Announcements\\Database\\Factories\\": "database/factories/",
      "Modules\\Announcements\\Database\\Seeders\\": "database/seeders/",
      "Modules\\Announcements\\Tests\\Support\\": "tests/Support/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Modules\\Announcements\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable"
}
